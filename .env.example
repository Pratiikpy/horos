# Horos configuration. Copy to .env and fill in. Never commit the filled version.

# Where this instance is published. Must match the resource URL in the x402 challenge.
HOROS_PUBLIC_BASE_URL=https://horos.example.xyz

# Ed25519 receipt signing identity. Generated on first run if absent; set it explicitly in
# production or every redeploy signs under a different key and receipts stop being attributable.
HOROS_SIGNING_KEY=.secrets/horos_ed25519.key

# X Layer anchoring. A dedicated key holding only gas — deliberately not the wallet that receives
# payments. About 0.0000005 OKB per anchor.
HOROS_ANCHOR_KEY=0x...

# Where payments are received.
HOROS_PAYTO=0x...

# OKX facilitator, for real x402 settlement. Without these the service runs in signature mode and
# verifies authorizations without moving money.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
X402_ENABLED=1
HOROS_X402_MODE=facilitator

# The model. Paths are explicit rather than derived from directory layout.
HOROS_KRONOS_SRC=/opt/horos/kronos
HOROS_MODEL_CACHE=/opt/horos/.models
HOROS_DEVICE=cpu

# Language model, used only by the A2A service to plan and narrate — never to produce a number.
LLM_BASE_URL=https://router-api.0g.ai/v1
LLM_MODEL=minimax-m3
MINIMAX_API_KEY=
